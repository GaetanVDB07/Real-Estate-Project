# Auth (required)
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Public app URL (used in embed snippets)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Splat pipeline: simulated (dev), gpu (requires ffmpeg + Nerfstudio), auto (gpu if tools found)
SPLAT_WORKER_MODE=simulated

# GPU pipeline tuning (optional)
# SPLAT_FRAME_FPS=2
# SPLAT_MAX_ITERATIONS=30000
# SPLAT_USE_DOCKER=true
# SPLAT_DOCKER_IMAGE=real-estate-splat-worker
